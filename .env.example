# PhenoSage — Root .env.example
# Copy to .env.local and fill in real values.
# NEVER commit secrets.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Available in: Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Supabase Ops / MCP / CLI (local-only, never client-exposed) ─────────────
# Project ref used by `.mcp.json`, `supabase link`, and the db-migrations
# workflow. The checked-in `.mcp.json` is already scoped to the production ref.
SUPABASE_PROJECT_REF=yjemotnclrnlxgcfntaf
# Direct Postgres password + URL for admin sessions, MCP-assisted SQL checks,
# and migration recovery. Use the session pooler URL for IPv4-only networks.
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.yjemotnclrnlxgcfntaf.supabase.co:5432/postgres

# ─── Analysis Service (Railway) ───────────────────────────────────────────────
# Internal URL — proxied through Next.js API routes, never called by browser
ANALYSIS_SERVICE_URL=https://your-analysis-service.railway.app
ANALYSIS_SERVICE_API_KEY=your-internal-api-key
# Optional server-side timeout for calls to Railway (milliseconds).
ANALYSIS_SERVICE_TIMEOUT_MS=30000
# HMAC secret shared with the analysis service. The Python worker signs
# POSTs to /api/internal/webhooks/analysis-complete with this key; the
# Next.js receiver rejects payloads whose signature doesn't match.
# Required in production; optional in local dev (only async-job callbacks
# need it — the synchronous /analyze path works without it).
ANALYSIS_WEBHOOK_SECRET=replace-with-32+-byte-random-hex

# Bearer token for Supabase Database Webhooks posted to
# /api/internal/webhooks/auth/user-created. Configure on the Supabase
# webhook ("HTTP Headers" → Authorization: Bearer <value>). Required in
# production; the receiver returns 503 if unset, so signups won't be
# auto-onboarded in dev without it (the app still works otherwise).
SUPABASE_AUTH_WEBHOOK_SECRET=replace-with-32+-byte-random-hex

# Bearer token for the Supabase Database Webhook on storage.objects
# (bucket = plant-images). The receiver at
# /api/internal/webhooks/storage/image-uploaded enqueues an analysis
# job per upload. Required in production.
SUPABASE_STORAGE_WEBHOOK_SECRET=replace-with-32+-byte-random-hex

# ─── Internal readiness probes ────────────────────────────────────────────────
# Server-side only. Send as `Authorization: Bearer <value>` (or ?secret= in
# container health checks) to /api/internal/ready and apps/analysis /ready.
READINESS_PROBE_SECRET=replace-with-32+-byte-random-hex

# ─── Google Gemini API (chat) ────────────────────────────────────────────────
# Server-side only. Free tier on gemini-2.5-flash, no card required.
# Generate at https://aistudio.google.com/app/apikey
# The chat route uses the openai SDK pointed at Gemini's OpenAI-compatible
# endpoint, so all tool calls / streaming / message format stay identical.
GEMINI_API_KEY=AIza...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Set in Vercel project settings; Vercel Cron sends it as `Authorization: Bearer <value>`
CRON_SECRET=replace-with-32+-byte-random-hex

# ─── Distributed rate limiting (Upstash Redis) ───────────────────────────────
# Server-side only. Required in production for cross-instance enforcement;
# leave blank in local dev to fall back to the in-memory limiter (logged on boot).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Resend (transactional email) ────────────────────────────────────────────
# Server-side only. When unset, the daily-summary cron + finding-alert
# pipeline log a warn and skip the email step (in-app notification still
# fires). Generate at https://resend.com/api-keys.
RESEND_API_KEY=
# Verified sender ("Display Name <user@your-domain.com>"). Required when
# RESEND_API_KEY is set; the email pipeline refuses to dispatch otherwise.
RESEND_FROM_EMAIL=

# ─── Observability (optional) ────────────────────────────────────────────────
# Sentry — leave empty to disable. Populate to enable error reporting.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Fraction of traces to sample (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry — set OTEL_ENABLED=true to enable OTLP export.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=phenosage
