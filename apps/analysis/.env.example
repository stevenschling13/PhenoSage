# apps/analysis — .env.example
# Copy to .env for local development.
# NEVER commit real secrets.

# ─── Service Auth ─────────────────────────────────────────────────────────────
# Shared secret with the Next.js proxy. Must match ANALYSIS_SERVICE_API_KEY in apps/web.
ANALYSIS_SERVICE_API_KEY=dev-api-key
# Shared HMAC key used to sign POSTs to the Next.js receiver at
# /api/internal/webhooks/analysis-complete. Must match
# ANALYSIS_WEBHOOK_SECRET in apps/web. Required when the async
# analysis_jobs callback path is enabled.
ANALYSIS_WEBHOOK_SECRET=replace-with-32+-byte-random-hex
# Optional shared readiness probe secret. When set, /ready requires
# `Authorization: Bearer <value>` or ?secret=<value>.
READINESS_PROBE_SECRET=replace-with-32+-byte-random-hex

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (the Vercel app URL in production).
ALLOWED_ORIGINS=http://localhost:3000

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Supabase ────────────────────────────────────────────────────────────────
# Used to fetch private images from Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# ─── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=phenosage-analysis
