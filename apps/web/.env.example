# apps/web — .env.example
# Copy to .env.local for local development.
# NEVER commit real secrets.

# ─── Supabase (public — safe to expose to browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (server-side only) ──────────────────────────────────────────────
# Set in Vercel environment → "Server" exposure only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Analysis Service (Railway) ───────────────────────────────────────────────
# Never exposed to the browser. Set in Vercel environment → "Server" only.
ANALYSIS_SERVICE_URL=https://your-analysis.railway.app
ANALYSIS_SERVICE_API_KEY=your-internal-shared-secret
# Optional server-side timeout for calls to Railway (milliseconds).
ANALYSIS_SERVICE_TIMEOUT_MS=30000
# HMAC secret shared with the analysis service. Verifies signatures on
# POSTs to /api/internal/webhooks/analysis-complete. Required in
# production; optional in dev/preview.
ANALYSIS_WEBHOOK_SECRET=replace-with-32+-byte-random-hex

# Bearer token for Supabase Database Webhooks fired on auth.users INSERT.
# Required in production. See the receiver at
# /api/internal/webhooks/auth/user-created.
SUPABASE_AUTH_WEBHOOK_SECRET=replace-with-32+-byte-random-hex

# Bearer token for the storage.objects (bucket = plant-images) Database
# Webhook. Receiver at /api/internal/webhooks/storage/image-uploaded
# auto-enqueues analysis for each successful upload. Required in production.
SUPABASE_STORAGE_WEBHOOK_SECRET=replace-with-32+-byte-random-hex

# ─── GitHub → Discord forwarder (optional) ───────────────────────────────────
# Receives GitHub webhook deliveries at /api/internal/webhooks/github and
# forwards selected events to DISCORD_WEBHOOK_URL. Both vars are optional;
# when unset the receiver returns 503 and Discord posts are skipped.
GITHUB_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=

# ─── Internal readiness probes ────────────────────────────────────────────────
# Server-side only. Send as `Authorization: Bearer <value>` (or ?secret= in
# container health checks) to /api/internal/ready.
READINESS_PROBE_SECRET=replace-with-32+-byte-random-hex

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Server-side only. Set in Vercel project settings; Vercel Cron sends it as
# `Authorization: Bearer <value>` to /api/internal/cron/** and /api/internal/diag.
CRON_SECRET=replace-with-32+-byte-random-hex

# ─── Google Gemini API (chat) ────────────────────────────────────────────────
# Server-side only. Free tier on gemini-2.5-flash, no card required.
# Generate at https://aistudio.google.com/app/apikey
# We use the openai SDK pointed at Gemini's OpenAI-compatible endpoint,
# so tool calls / streaming / message format all stay identical.
GEMINI_API_KEY=AIza...

# ─── Distributed rate limiting (Upstash Redis) ───────────────────────────────
# Server-side only. Required in production. When unset, the limiter falls
# back to a per-instance in-memory map (a warn is logged on boot).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Resend (transactional email) ────────────────────────────────────────────
# Server-side only. When unset, the daily-summary cron + finding-alert
# pipeline log a warn and skip the email step (in-app notification still
# fires). Generate at https://resend.com/api-keys.
RESEND_API_KEY=
# Verified sender ("Display Name <user@your-domain.com>"). Required when
# RESEND_API_KEY is set; the email pipeline refuses to dispatch otherwise.
RESEND_FROM_EMAIL=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ─── Observability (optional) ────────────────────────────────────────────────
# Leave empty to disable error reporting and tracing.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
