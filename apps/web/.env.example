# apps/web — .env.example
# Copy to .env.local for local development.
# NEVER commit real secrets.

# ─── Supabase (public — safe to expose to browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase (server-side only) ──────────────────────────────────────────────
# Set in Vercel environment → "Server" exposure only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Analysis Service (Railway) ───────────────────────────────────────────────
# Never exposed to the browser. Set in Vercel environment → "Server" only.
ANALYSIS_SERVICE_URL=https://your-analysis.railway.app
ANALYSIS_SERVICE_API_KEY=your-internal-shared-secret

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Server-side only
OPENAI_API_KEY=sk-...

# ─── Distributed rate limiting (Upstash Redis) ───────────────────────────────
# Server-side only. Required in production. When unset, the limiter falls
# back to a per-instance in-memory map (a warn is logged on boot).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# ─── Observability (optional) ────────────────────────────────────────────────
# Leave empty to disable error reporting and tracing.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
