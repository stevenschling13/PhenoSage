{
  "name": "phenosage",
  "version": "0.1.0",
  "private": true,
  "description": "Plant-health AI: visual doctor, longitudinal intelligence, chat, alerts",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "node scripts/check-env-contract.mjs",
    "check:ready": "node scripts/check-runtime-readiness.mjs",
    "check:routes": "node scripts/check-route-boundaries.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:code-scanning": "node scripts/check-code-scanning-patterns.mjs",
    "check:budgets": "node scripts/check-file-budgets.mjs",
    "check:server-actions": "node scripts/check-server-action-exports.mjs",
    "check:scope": "node scripts/check-changed-scope.mjs",
    "security:routes": "node scripts/check-route-security.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "pr:guardian": "node scripts/pr-guardian.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs",
    "validate": "pnpm run check:env && pnpm run check:routes && pnpm run check:imports && pnpm run check:code-scanning && pnpm run check:budgets && pnpm run check:server-actions",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.4.2",
    "turbo": "^2.9.12"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "pnpm --filter web exec eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "cookie@<0.7.0": ">=0.7.0",
      "postcss@<8.5.10": ">=8.5.10",
      "vite": "^6.4.2",
      "esbuild": "^0.25.0",
      "fast-uri@<3.1.2": ">=3.1.2"
    }
  }
}
