{
  "name": "phenosage",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered cannabis grow operating system",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "type-check": "pnpm --filter web type-check && pnpm --filter shared type-check",
    "clean": "pnpm --filter web clean && pnpm --filter shared clean",
    "check:env": "node scripts/check-env-contract.mjs",
    "check:routes": "node scripts/check-route-boundaries.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:scope": "node scripts/check-changed-scope.mjs",
    "validate": "pnpm run check:env && pnpm run check:routes && pnpm run check:imports"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "cookie@<0.7.0": ">=0.7.0"
    }
  }
}
